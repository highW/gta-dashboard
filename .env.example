# Settings for Docker Compose (compose.yaml and compose.dev.yaml).
# Copy to .env in this folder and fill in. Never commit .env.

# The address people open in the browser. Also used for the Discord
# redirect: register <PUBLIC_URL>/api/auth/discord/callback in the Discord
# developer portal.
PUBLIC_URL=http://localhost:8000
# The port on this machine the dashboard is served on (must match PUBLIC_URL).
HTTP_PORT=8000
# true once the dashboard is served over HTTPS.
COOKIE_SECURE=false

# MySQL. Use long random values, letters and digits only (the app password
# goes inside a connection string). Both are read only when the database is
# created the first time; changing them later does not change the database.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# API-key sign-in, mainly for testing: 24+ random characters each. Empty =
# no key for that role (people can still get it through Discord + Members).
ADMIN_KEY=
VIEWER_KEY=
POLICE_KEY=
SUPERVISOR_KEY=
PROSECUTOR_KEY=
JUDGE_KEY=

# Discord sign-in (optional).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BOOTSTRAP_ADMIN_DISCORD_ID=

# Key for the load balancer's /lb-status page.
LB_STATUS_KEY=
