# Database: the limited MySQL user for the app, not root.
MYSQL_DSN=dashboard_app:change-me@tcp(localhost:3306)/dashboard

# Port for this API instance (a PORT set in the shell wins over this file).
PORT=8080

# API-key sign-in: 24+ random characters each. Empty = that role is disabled.
ADMIN_KEY=
VIEWER_KEY=
POLICE_KEY=
JUDGE_KEY=

# Discord sign-in (optional). The redirect URI must match the Discord developer portal exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
BOOTSTRAP_ADMIN_DISCORD_ID=

# Where the frontend runs, and whether cookies require HTTPS (true in production).
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Redis: cache, sessions and the rate limiter. Leave empty for a Redis on
# this machine. Format: redis://[user:password@]host:port[/db]
# (rediss:// instead of redis:// for TLS).
REDIS_URL=

# Proxies in front of the API whose X-Forwarded-For header is believed, as
# comma-separated addresses or CIDR ranges. Leave empty for the default: this
# machine only, which covers the bundled load balancer. If the load balancer
# runs somewhere else (another host, a Docker network), list its address or
# network here, e.g. 127.0.0.0/8,172.16.0.0/12. "none" trusts nobody.
TRUSTED_PROXIES=

# Used by the load balancer (server/lb).
LB_STATUS_KEY=